<Window x:Class="TaskManagerPlusPlus.AiAgentCoordinatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI agent team" Height="760" Width="1050" MinHeight="560" MinWidth="760"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="AI agent team" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose up to five specialists to analyze the current read-only process and current-user startup snapshots. A lead agent summarizes their results. Each proposed local change requires its own confirmation."
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Lead summary" FontWeight="SemiBold"/>
                <TextBlock x:Name="LeadSummaryText" Text="Select specialists and start an analysis."
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AgentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top"
                                          Margin="0,3,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Instructions}" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,3,0,4"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Bg2}"
                                                        BorderBrush="{DynamicResource ControlBorder}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="10" Margin="0,4,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TargetLabel}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource TextMuted}"
                                                                       TextWrapping="Wrap" Margin="0,3,8,0"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}"
                                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding ButtonLabel}"
                                                                Click="ApproveActionButton_Click"
                                                                IsEnabled="{Binding CanApprove}"
                                                                Style="{DynamicResource BtnDanger}"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Start"
                                        Click="StartAgentButton_Click"
                                        IsEnabled="{Binding CanStart}"
                                        Style="{DynamicResource BtnSecondary}"
                                        Margin="12,0,0,0" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="StartSelectedButton" Content="Start selected"
                        Click="StartSelectedButton_Click" Style="{DynamicResource BtnPrimary}"
                        Margin="0,0,8,0"/>
                <Button x:Name="StopButton" Content="Stop"
                        Click="StopButton_Click" Style="{DynamicResource BtnDanger}"
                        IsEnabled="False" Margin="0,0,8,0"/>
                <Button Content="Close" Click="CloseButton_Click"
                        Style="{DynamicResource BtnSecondary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
