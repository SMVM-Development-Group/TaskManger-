<Window x:Class="TaskManagerPlusPlus.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup apps" Height="620" Width="1000" MinHeight="480" MinWidth="720"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Current-user startup apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Disable or restore entries from your user Run key and Startup folder. Changes are reversible and affect only your Windows account."
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <DataGrid x:Name="StartupEntriesGrid" Grid.Row="1"
                  Style="{DynamicResource DataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="StartupEntriesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="STATE" Binding="{Binding IsEnabled}" Width="80"/>
                <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="190"/>
                <DataGridTextColumn Header="COMMAND / PATH" Binding="{Binding Command}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Disable…" Style="{DynamicResource BtnDanger}"
                        Click="DisableButton_Click" IsEnabled="False" x:Name="DisableButton"
                        Margin="0,0,8,0"/>
                <Button Content="Restore…" Style="{DynamicResource BtnSecondary}"
                        Click="RestoreButton_Click" IsEnabled="False" x:Name="RestoreButton"
                        Margin="0,0,8,0"/>
                <Button Content="Refresh" Style="{DynamicResource BtnSecondary}"
                        Click="RefreshButton_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{DynamicResource BtnPrimary}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
