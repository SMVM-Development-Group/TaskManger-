<Window x:Class="TaskManagerPlusPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TaskManager++" Height="900" Width="1400" MinHeight="700" MinWidth="1050"
        Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ Title bar ════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg1}" x:Name="TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path Data="{StaticResource IconGauge}" Style="{StaticResource IconPath}"
                      Width="16" Height="16" Stroke="{DynamicResource Accent}"/>
                <TextBlock Text="TaskManager++" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Window controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="MaximizeButton_Click" ToolTip="Maximize"
                        x:Name="MaximizeButton">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}"
                          Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ════════════════════ Main content ════════════════════ -->
        <Grid Grid.Row="1" Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ── Header row ─────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TASKMANAGER++" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="System monitor" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="A clearer view of memory, processes and system activity"
                           Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="UpdatedText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,16,0"/>

                <!-- AI assistant dropdown button -->
                <Button x:Name="AiAssistantButton" Style="{DynamicResource BtnPrimary}"
                        Click="AiAssistantButton_Click" Margin="0,0,8,0"
                        ToolTip="Analyze the five processes using the most RAM or manage your AI API key">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}"
                              Stroke="White" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="AI assistant ▾" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Deep scan &amp; optimize (top 40 RAM users)"
                                      Click="DeepScanProcessesButton_Click"/>
                            <MenuItem Header="AI Debloat review (measured low-activity processes)"
                                      Click="DebloatProcessesButton_Click"/>
                            <MenuItem Header="Scan top 5 RAM users"     Click="AnalyzeProcessesButton_Click"/>
                            <MenuItem Header="Analyze selected process"  Click="AnalyzeSelectedProcessButton_Click"/>
                            <MenuItem Header="Open AI chat…"            Click="ChatAboutSelectedProcessButton_Click"/>
                            <Separator/>
                            <MenuItem Header="AI API key settings…"     Click="AiSettingsButton_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Content="Refresh" Style="{DynamicResource BtnSecondary}"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── Stat cards row ─────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Physical Memory card (clickable) -->
            <Button Grid.Column="0" Margin="0,0,9,0"
                    ToolTip="Click to view RAM usage chart" Click="PhysicalMemoryCard_Click"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource Bg3}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BgHover}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush"  Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BgPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="PHYSICAL MEMORY IN USE  ·  CLICK FOR CHART"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="PhysicalUsedText" Text="—"
                               Style="{StaticResource StatValue}" Margin="0,9,0,2"/>
                    <TextBlock x:Name="PhysicalUsedDetailText" Text="—"
                               Style="{StaticResource SubText}"/>
                    <ProgressBar x:Name="PhysicalProgress" Height="5" Margin="0,14,0,0"
                                 Minimum="0" Maximum="100"/>
                </StackPanel>
            </Button>

            <!-- Available to apps card -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                <StackPanel>
                    <TextBlock Text="AVAILABLE TO APPS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock x:Name="AvailableText" Text="—"
                               Style="{StaticResource StatValue}" Margin="0,9,0,2"/>
                    <TextBlock x:Name="AvailableDetailText"
                               Text="Free + reclaimable standby memory"
                               Style="{StaticResource SubText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Process list card ──────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Margin="16,14,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Processes" Style="{StaticResource SectionTitle}" FontSize="17"/>
                        <TextBlock x:Name="ProcessCountText" Text="Loading processes…"
                                   Style="{StaticResource SubText}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="ProcessSummaryText"
                                   Text="Filtered total: waiting for first refresh"
                                   FontSize="12" Foreground="{DynamicResource Accent}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Width="220" Height="36"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Filter by process name or PID"/>
                        <Button Content="Autostart…"
                                Style="{DynamicResource BtnSecondary}"
                                Click="StartupManagerButton_Click" Margin="10,0,0,0"
                                ToolTip="Review and reversibly disable current-user startup entries"/>
                        <Button Content="End task" Margin="10,0,0,0"
                                Style="{DynamicResource BtnDanger}"
                                Click="EndTaskButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="ProcessesGrid" Grid.Row="1"
                          Style="{DynamicResource DataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="True" CanUserSortColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PROCESS"
                                            Binding="{Binding Name}"
                                            SortMemberPath="Name" Width="2*"/>
                        <DataGridTextColumn Header="PID"
                                            Binding="{Binding Id}"
                                            SortMemberPath="Id" Width="70"/>
                        <DataGridTextColumn Header="CPU"
                                            Binding="{Binding CpuPercent, StringFormat={}{0:N1}%}"
                                            SortMemberPath="CpuPercent" Width="80"/>
                        <DataGridTextColumn Header="RAM IN USE"
                                            Binding="{Binding WorkingSetText}"
                                            SortMemberPath="WorkingSetBytes" Width="180"/>
                        <DataGridTextColumn Header="MEMORY ALLOCATED"
                                            Binding="{Binding PrivateCommitText}"
                                            SortMemberPath="PrivateCommitBytes" Width="190"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,12,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}"
                   Text="RAM in use is physical memory currently resident. Memory allocated can be larger because some committed memory may be paged out. Shared RAM pages can appear in more than one process. Right-click a process for CPU, RAM history, and GPU / VRAM details."
                   TextWrapping="Wrap"/>
    </Grid>
    </Grid>
</Window>
