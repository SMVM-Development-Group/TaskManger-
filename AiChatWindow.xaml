<Window x:Class="TaskManagerPlusPlus.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ask AI about process" Height="700" Width="850" MinHeight="500" MinWidth="600"
        Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ Title bar ════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg1}" x:Name="TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}"
                      Width="14" Height="14" Stroke="{DynamicResource Accent}"/>
                <TextBlock Text="Ask AI about process" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Click="WindowMinimize_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="WindowMaximize_Click" ToolTip="Maximize"
                        x:Name="MaximizeButton">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}"
                          Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ════════════════════ Content ════════════════════ -->
        <Grid Grid.Row="1" Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <TextBlock Text="Chat about a process" Style="{StaticResource PageTitle}"/>

        <Grid Grid.Row="1" Margin="0,8,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROCESS" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0"/>
            <ComboBox x:Name="ProcessBox" Grid.Column="1" Height="38"
                      DisplayMemberPath="DisplayLabel"
                      SelectionChanged="ProcessBox_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="MODEL" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0"/>
            <ComboBox x:Name="ModelBox" Grid.Column="1" Height="38" IsEditable="True"
                      IsTextSearchEnabled="True"/>
            <Button x:Name="LoadModelsButton" Grid.Column="2" Content="Load models"
                    Click="LoadModelsButton_Click" Margin="8,0,0,0"
                    Style="{DynamicResource BtnSecondary}"
                    ToolTip="Fetch model IDs available to this NVIDIA API key"/>
        </Grid>

        <TextBox x:Name="ConversationText" Grid.Row="3"
                 IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 Padding="14" FontSize="13"
                 Background="{DynamicResource Bg2}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource ControlBorder}"/>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,8,0,8"
                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QuestionBox" MinHeight="42" MaxHeight="110" Padding="10"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource Bg2}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource ControlBorder}"
                     ToolTip="Type your question about the selected process"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                    Style="{DynamicResource BtnPrimary}"
                    Click="SendButton_Click" Margin="10,0,0,0" MinWidth="86"/>
        </Grid>
    </Grid>
    </Grid>
</Window>
