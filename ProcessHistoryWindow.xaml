<Window x:Class="TaskManagerPlusPlus.ProcessHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process usage history" Height="600" Width="980" MinHeight="480" MinWidth="700"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}"
                       Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#0D1525" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Canvas x:Name="ChartCanvas" />
        </Border>
        <TextBlock Grid.Row="2" Text="History is collected while TaskManager++ is open and is kept for the last 30 minutes. GPU memory values come from Windows GPU Process Memory counters and may be unavailable on some systems."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Margin="0,12,0,0" />
    </Grid>
</Window>
