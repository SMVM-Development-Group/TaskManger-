<Window x:Class="TaskManagerPlusPlus.SystemHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System usage history" Height="620" Width="980" MinHeight="480" MinWidth="700"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="System usage history" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Metric" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                <ComboBox x:Name="MetricBox" Width="210" SelectedIndex="0">
                    <ComboBoxItem Content="Total CPU usage"/>
                    <ComboBoxItem Content="Physical RAM in use"/>
                    <ComboBoxItem Content="Available physical RAM"/>
                    <ComboBoxItem Content="RAM usage percentage"/>
                </ComboBox>
                <TextBlock Text="Shown" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="18,0,10,0"/>
                <ComboBox x:Name="RangeBox" Width="150" SelectedIndex="1">
                    <ComboBoxItem Content="Last 1 minute"/>
                    <ComboBoxItem Content="Last 5 minutes"/>
                    <ComboBoxItem Content="Last 10 minutes"/>
                    <ComboBoxItem Content="Last 30 minutes"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextMuted}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Canvas x:Name="ChartCanvas"/>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="System history is collected every 2 seconds while TaskManager++ is open, the graph updates live, and samples are kept for up to 30 minutes. CPU is total logical-processor utilization; RAM values are system-wide physical memory counters."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                   FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</Window>
