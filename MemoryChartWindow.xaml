<Window x:Class="TaskManagerPlusPlus.MemoryChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RAM usage by process" Height="650" Width="940" MinHeight="560" MinWidth="760"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg0}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ Title bar ════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource Bg1}" x:Name="TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path Data="{StaticResource IconGauge}" Style="{StaticResource IconPath}"
                      Width="15" Height="15" Stroke="{DynamicResource Accent}"/>
                <TextBlock Text="RAM usage by process" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                    <Path Data="{StaticResource IconMinimize}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="MaximizeButton_Click" ToolTip="Maximize"
                        x:Name="MaximizeButton">
                    <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource IconPath}"
                          Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="12" Height="12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ════════════════════ Content ════════════════════ -->
        <Grid Grid.Row="1" Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="RAM in use by the 10 biggest processes"
                       Style="{StaticResource PageTitle}" FontSize="23"/>
            <TextBlock x:Name="SystemMemoryText"
                       Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,4,0,0"/>
            <TextBlock x:Name="ProcessMemoryTotalText"
                       Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Viewbox MaxWidth="290" MaxHeight="290" Stretch="Uniform">
                <Canvas x:Name="ChartCanvas" Width="280" Height="280"/>
            </Viewbox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                <ItemsControl x:Name="LegendList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="12" CornerRadius="3"
                                        Background="{Binding Color}" Margin="0,4,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding ValueText}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="RAM in use is the process working set, matching the process list. Shared memory can appear in more than one process, so process totals may exceed system RAM in use."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="12" Margin="0,14,0,0"/>
    </Grid>
    </Grid>
</Window>
