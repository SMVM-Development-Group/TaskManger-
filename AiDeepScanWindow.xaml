<Window x:Class="TaskManagerPlusPlus.AiDeepScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI deep scan" Height="720" Width="920" MinHeight="540" MinWidth="680"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Deep scan &amp; optimize" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,8,0,12">
            <TextBlock Text="The AI reviews CPU, RAM, GPU/VRAM, and available history for the top 40 processes by RAM use. They are analyzed in groups of five, one NVIDIA request at a time, with a two-second pause between requests."
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
            <TextBlock x:Name="ModeText" Margin="0,8,0,0" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,0,0,12"
                   TextWrapping="Wrap" />
        <ListBox x:Name="RecommendationsList" Grid.Row="3"
                 Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource ControlBorder}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Bg3}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProcessLabel}" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="End task…" Click="EndRecommendedProcessButton_Click"
                                    Visibility="{Binding ActionVisibility}" IsEnabled="{Binding CanEnd}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                       Text="{Binding Reason}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                       Text="{Binding Result}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Accent}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
