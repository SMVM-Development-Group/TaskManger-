<Window x:Class="TaskManagerPlusPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskManager++" Height="900" Width="1400" MinHeight="700" MinWidth="1050"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#172238" />
            <Setter Property="Foreground" Value="#9EACC1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style x:Key="MemoryCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EDF3FC" />
            <Setter Property="Background" Value="#080B12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#263650" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#68758B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TASKMANAGER++" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="System monitor" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="A clearer view of memory, processes and system activity"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="UpdatedText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,16,0" />
                <Button x:Name="AiAssistantButton" Content="AI assistant ▾" Click="AiAssistantButton_Click"
                        Background="{StaticResource AccentBrush}" Foreground="#0B1020"
                        FontWeight="SemiBold" Margin="0,0,8,0"
                        ToolTip="Analyze the five processes using the most RAM or manage your AI API key">
                    <Button.ContextMenu>
                        <ContextMenu Background="#080B12" BorderBrush="#35435A" BorderThickness="1">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource AiMenuItem}" />
                            </ContextMenu.Resources>
                            <MenuItem Header="Scan top 5 RAM users" Click="AnalyzeProcessesButton_Click" />
                            <MenuItem Header="Analyze selected process" Click="AnalyzeSelectedProcessButton_Click" />
                            <MenuItem Header="Open AI chat…" Click="ChatAboutSelectedProcessButton_Click" />
                            <Separator Background="#35435A" />
                            <MenuItem Header="AI API key settings…" Click="AiSettingsButton_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Refresh" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MemoryCardButton}" Margin="0,0,10,0"
                    ToolTip="Click to view RAM usage chart" Click="PhysicalMemoryCard_Click">
                <StackPanel>
                    <TextBlock Text="PHYSICAL MEMORY IN USE  ·  CLICK FOR CHART" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="PhysicalUsedText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,9,0,2" />
                    <TextBlock x:Name="PhysicalUsedDetailText" Text="—" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <ProgressBar x:Name="PhysicalProgress" Height="5" Margin="0,15,0,0" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource AccentBrush}" Background="#27344A" BorderThickness="0" />
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="AVAILABLE TO APPS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="AvailableText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,9,0,2" />
                    <TextBlock x:Name="AvailableDetailText" Text="Free + reclaimable standby memory"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Processes" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProcessCountText" Text="Loading processes…"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="ProcessSummaryText" Text="Filtered total: waiting for first refresh"
                                   FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Width="220" Height="36" Padding="10,7"
                                 Background="#0D1525" Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource PanelBorderBrush}" CaretBrush="{StaticResource AccentBrush}"
                                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Filter by process name or PID" />
                        <Button Content="End task" Margin="10,0,0,0" Background="#412A37"
                                BorderBrush="#694052" Click="EndTaskButton_Click" />
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="ProcessesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                          CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="#0E1626" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#202C43"
                          RowBackground="#10192A" AlternatingRowBackground="#121D30"
                          HeadersVisibility="Column" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" SortMemberPath="Id" Width="70" />
                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat={}{0:N1}%}"
                                            SortMemberPath="CpuPercent" Width="80" />
                        <DataGridTextColumn Header="RAM IN USE" Binding="{Binding WorkingSetText}"
                                            SortMemberPath="WorkingSetBytes" Width="180" />
                        <DataGridTextColumn Header="MEMORY ALLOCATED" Binding="{Binding PrivateCommitText}"
                                            SortMemberPath="PrivateCommitBytes" Width="190" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,12,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   Text="RAM in use is physical memory currently resident. Memory allocated can be larger because some committed memory may be paged out. Shared RAM pages can appear in more than one process." />
    </Grid>
</Window>
